@page "/account/reset-password"
@inject IStringLocalizer<SharedResource> Localizer
@inject IAccountClientService AccountService
@inject NavigationManager Navigation

<PageTitle>@Localizer["Account_ResetPassword_Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h4" GutterBottom="true">@Localizer["Account_ResetPassword_Heading"]</MudText>

            <AccountStatusMessage Status="@_statusMessage" Errors="@_errors" Severity="@_statusSeverity" />

            @if (!_submitted)
            {
                <EditForm Model="@_model" OnValidSubmit="HandleSubmitAsync" FormName="reset-password">
                    <DataAnnotationsValidator />

                    <MudTextField @bind-Value="_model.NewPassword"
                                  Label="@Localizer["Account_NewPassword_Label"]"
                                  InputType="InputType.Password"
                                  Required="true"
                                  RequiredError="@Localizer["Account_Password_Required"]"
                                  autocomplete="new-password"
                                  aria-required="true"
                                  Disabled="@_isBusy"
                                  Class="mb-4"
                                  For="@(() => _model.NewPassword)" />

                    <MudTextField @bind-Value="_model.ConfirmPassword"
                                  Label="@Localizer["Account_ConfirmPassword_Label"]"
                                  InputType="InputType.Password"
                                  Required="true"
                                  RequiredError="@Localizer["Account_ConfirmPassword_Required"]"
                                  autocomplete="new-password"
                                  aria-required="true"
                                  Disabled="@_isBusy"
                                  Class="mb-4"
                                  For="@(() => _model.ConfirmPassword)" />

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">@Localizer["Account_Processing"]</MudText>
                        }
                        else
                        {
                            @Localizer["Account_ResetPassword_Button"]
                        }
                    </MudButton>
                </EditForm>
            }
            else
            {
                <MudStack Row="true" Justify="Justify.Center">
                    <MudButton Href="/account/login" Variant="Variant.Text" Color="Color.Primary">
                        @Localizer["Account_Login_Link"]
                    </MudButton>
                </MudStack>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>
