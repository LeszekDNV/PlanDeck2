@page "/account/forgot-password"
@inject IStringLocalizer<SharedResource> Localizer
@inject IAccountClientService AccountService

<PageTitle>@Localizer["Account_ForgotPassword_Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h4" GutterBottom="true">@Localizer["Account_ForgotPassword_Heading"]</MudText>

            <AccountStatusMessage Status="@_statusMessage" Errors="@_errors" Severity="@_statusSeverity" />

            @if (!_submitted)
            {
                <EditForm Model="@_model" OnValidSubmit="HandleSubmitAsync" FormName="forgot-password">
                    <DataAnnotationsValidator />

                    <MudTextField @bind-Value="_model.Email"
                                  Label="@Localizer["Account_Email_Label"]"
                                  InputType="InputType.Email"
                                  Required="true"
                                  RequiredError="@Localizer["Account_Email_Required"]"
                                  autocomplete="email"
                                  aria-required="true"
                                  Disabled="@_isBusy"
                                  Class="mb-4"
                                  For="@(() => _model.Email)" />

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">@Localizer["Account_Processing"]</MudText>
                        }
                        else
                        {
                            @Localizer["Account_ForgotPassword_Button"]
                        }
                    </MudButton>
                </EditForm>
            }
        </MudCardContent>
        <MudCardActions Class="justify-center">
            <MudButton Href="/account/login" Variant="Variant.Text" Color="Color.Primary">
                @Localizer["Account_Login_Link"]
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>
