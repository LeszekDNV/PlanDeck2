<MudStack Spacing="2" Class="mt-4">
    <MudButton ButtonType="ButtonType.Submit"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Disabled="IsBusy">
        @if (IsBusy)
        {
            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ms-2">@Localizer["Account_Processing"]</MudText>
        }
        else
        {
            @PrimaryText
        }
    </MudButton>

    @if (ShowEntra)
    {
        <MudText Align="Align.Center" Typo="Typo.body2">@Localizer["Account_Or"]</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="IsBusy"
                   OnClick="OnEntraClick"
                   StartIcon="@Icons.Custom.Brands.Microsoft">
            @EntraText
        </MudButton>
    }
</MudStack>
