<MudText Typo="Typo.caption">@Localizer["Account_PasswordRequirements"]</MudText>
<MudList T="string" Dense="true" Class="mb-4">
    <MudListItem Icon="@GetIcon(HasLength)" Text="@Localizer["Account_PasswordMinLength"]" />
    <MudListItem Icon="@GetIcon(HasUpper)" Text="@Localizer["Account_PasswordUppercase"]" />
    <MudListItem Icon="@GetIcon(HasLower)" Text="@Localizer["Account_PasswordLowercase"]" />
    <MudListItem Icon="@GetIcon(HasDigit)" Text="@Localizer["Account_PasswordDigit"]" />
    <MudListItem Icon="@GetIcon(HasSpecial)" Text="@Localizer["Account_PasswordSpecial"]" />
</MudList>
