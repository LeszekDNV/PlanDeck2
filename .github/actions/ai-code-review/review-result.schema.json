{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeszekDNV/PlanDeck2/ai-code-review/review-result.schema.json",
  "title": "PlanDeck AI code review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewedHeadSha",
    "analysis",
    "criteria",
    "blockers",
    "summary"
  ],
  "properties": {
    "reviewedHeadSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "limitations"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            },
            "required": [
              "complete"
            ]
          },
          "then": {
            "properties": {
              "limitations": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "limitations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "solid-design",
              "clean-architecture",
              "dry-kiss-yagni",
              "blazor-mudblazor",
              "correctness-maintainability",
              "dependency-configuration",
              "data-persistence",
              "async-concurrency",
              "security-authorization",
              "errors-observability",
              "performance-resources",
              "accessibility-ux",
              "testing-verification",
              "api-contracts",
              "pr-quality-scope"
            ]
          },
          "score": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              {
                "const": "N/A"
              }
            ]
          },
          "naReason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "evidence": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "changedPath",
                "finding"
              ],
              "properties": {
                "changedPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 260
                },
                "finding": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "score": {
                  "const": "N/A"
                }
              },
              "required": [
                "score"
              ]
            },
            "then": {
              "required": [
                "naReason"
              ]
            }
          }
        ]
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "changedPath",
          "finding"
        ],
        "properties": {
          "criterionId": {
            "type": "string",
            "enum": [
              "solid-design",
              "clean-architecture",
              "dry-kiss-yagni",
              "blazor-mudblazor",
              "correctness-maintainability",
              "dependency-configuration",
              "data-persistence",
              "async-concurrency",
              "security-authorization",
              "errors-observability",
              "performance-resources",
              "accessibility-ux",
              "testing-verification",
              "api-contracts",
              "pr-quality-scope"
            ]
          },
          "changedPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          },
          "finding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
